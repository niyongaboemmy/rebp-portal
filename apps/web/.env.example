# ---- Core ----
# dev | staging | production. "dev" simulates email/SMS: one-time codes are shown on screen.
# Defaults to dev outside a production build. Keep dev until the mail/SMS gateway is connected.
APP_ENV=dev
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rebp_dev?schema=public

# 32-byte keys, base64. Generate with: openssl rand -base64 32
# AUTH_SECRET signs short-lived cookies; APP_ENCRYPTION_KEY encrypts TOTP secrets (SEC-003).
AUTH_SECRET=replace-me-with-openssl-rand-base64-32
APP_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32

# ---- Two-step verification (FR-ACC-004). "true" makes it mandatory for staff before they can use
# the back office; anything else (default) sends them to set it up after sign-in but lets them skip.
MFA_ENFORCE=false

# ---- Google sign-in (optional). Leave blank to hide the Google button. ----
# OAuth 2.0 Client ID (Web) from Google Cloud Console > APIs & Services > Credentials. Public value.
# Add every site address to the client's "Authorised JavaScript origins" (e.g. http://localhost:3000).
GOOGLE_CLIENT_ID=
# Optional: only the legacy redirect flow (/api/auth/google) uses it; its redirect URI is
# ${APP_URL}/api/auth/google/callback. The Google button needs only the client ID.
GOOGLE_CLIENT_SECRET=

# ---- Email (optional). Without SMTP_HOST emails are logged and shown at /dev/outbox. ----
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="REBP Portal <no-reply@rebp.local>"

# ---- SMS: "mock" logs messages (pilot default, ADR-005) ----
SMS_PROVIDER=mock

# ---- Documents (FR-DOC-008): encrypted at rest under APP_ENCRYPTION_KEY ----
STORAGE_DIR=./var/storage

# ---- Payments: "mock" = sandbox gateway with a simulated checkout (ADR-005) ----
PAYMENT_PROVIDER=mock
# HMAC secret for gateway webhooks; defaults to a key derived from AUTH_SECRET.
PAYMENT_WEBHOOK_SECRET=

# ---- Scheduled jobs: Bearer token for POST /api/jobs/run (renewal reminders, expiry, SLA) ----
CRON_SECRET=

# Check new passwords against Have I Been Pwned (k-anonymity). Set to false offline.
AUTH_BREACHED_PASSWORD_CHECK=true

# ---- Optional personal administrator created by `pnpm db:seed` (keep real values in .env only) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
